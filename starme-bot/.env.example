# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=

# --- Storage ---
STARME_DATA_DIR=./data

# --- Generator: mock | facefusion | instantid | replicate ---
STARME_GENERATOR=mock
FACEFUSION_WORKER_URL=http://127.0.0.1:8100
INSTANTID_WORKER_URL=http://127.0.0.1:8101

# --- Replicate (cloud, no GPU): free credits on signup, ~$0.0016/photo ---
REPLICATE_API_TOKEN=
REPLICATE_MODEL=pikachupichu25/image-faceswap
# Optional: map selfie/scene to the model's input keys
REPLICATE_INPUT_KEYS=

# --- Abuse prevention: none | face (reject selfies with no detected face) ---
STARME_SELFIE_GUARD=none

# --- Scene analyzer: heuristic | vlm ---
STARME_ANALYZER=heuristic

# --- VLM (OpenAI-compatible vision endpoint) ---
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# --- Misc ---
STARME_DRY_RUN=0
STARME_MAX_SELFIE_REUSE=0
